  "screens": [
    {
      "id": "overview",
      "title": "Overview",
      "purpose": "Establish scope and find the largest consumption or expense driver",
      "pattern": "Dashboard",
      "states": [
        "empty",
        "loading",
        "partial",
        "error"
      ],
      "stories": [
        "US-001"
      ],
      "actions": [
        {
          "id": "compare",
          "label": "Compare projects",
          "to": "projects"
        },
        {
          "id": "retry",
          "label": "Try again",
          "to": "state:loading"
        }
      ],
      "content": [
        {
          "kind": "text",
          "label": "Summary: tokens / rack value / effective expense / output; trend; top projects; grouped attention"
        }
      ]
    },
    {
      "id": "projects",
      "title": "Projects",
      "purpose": "Compare human projects and select one for investigation",
      "pattern": "CollectionList",
      "states": [
        "empty",
        "loading",
        "partial",
        "error"
      ],
      "stories": [
        "US-001"
      ],
      "actions": [
        {
          "id": "open-project",
          "label": "Open project",
          "to": "project"
        },
        {
          "id": "retry",
          "label": "Try again",
          "to": "state:loading"
        }
      ],
      "content": [
        {
          "kind": "text",
          "label": "Project rows: tokens / rack value / effective expense / commits / coverage; unassigned included"
        }
      ]
    },
    {
      "id": "project",
      "title": "Project detail",
      "purpose": "Explain a human project through folders, sessions and work",
      "pattern": "RecordDetail",
      "states": [
        "empty",
        "loading",
        "partial",
        "error"
      ],
      "stories": [
        "US-001"
      ],
      "actions": [
        {
          "id": "open-session",
          "label": "Open session",
          "to": "session"
        },
        {
          "id": "all-sessions",
          "label": "Browse project sessions",
          "to": "sessions"
        },
        {
          "id": "back",
          "label": "Back to projects",
          "to": "projects"
        },
        {
          "id": "retry",
          "label": "Try again",
          "to": "state:loading"
        }
      ],
      "content": [
        {
          "kind": "text",
          "label": "Summary; folder or agent-project contributions; sessions; commits and PR titles/state; assignment evidence"
        }
      ]
    },
    {
      "id": "sessions",
      "title": "Sessions",
      "purpose": "Find a session by ID, title, folder, agent or time",
      "pattern": "CollectionList",
      "states": [
        "empty",
        "loading",
        "partial",
        "error"
      ],
      "stories": [
        "US-003"
      ],
      "actions": [
        {
          "id": "open-session",
          "label": "Open session",
          "to": "session"
        },
        {
          "id": "retry",
          "label": "Try again",
          "to": "state:loading"
        }
      ],
      "content": [
        {
          "kind": "text",
          "label": "Search; session rows with title, ID, project portions, dates, agent, route, tokens and both cost bases"
        }
      ]
    },
    {
      "id": "session",
      "title": "Session detail",
      "purpose": "Read a session and explain its usage and attribution",
      "pattern": "RecordDetail",
      "states": [
        "empty",
        "loading",
        "partial",
        "error"
      ],
      "stories": [
        "US-003"
      ],
      "actions": [
        {
          "id": "back",
          "label": "Back to sessions",
          "to": "sessions"
        },
        {
          "id": "retry",
          "label": "Try again",
          "to": "state:loading"
        }
      ],
      "content": [
        {
          "kind": "text",
          "label": "Title and full ID; totals and peak context; project portions; route and payer evidence; paged trace; verified work"
        }
      ]
    },
    {
      "id": "accounts",
      "title": "Accounts",
      "purpose": "Inspect remaining capacity, resets and expense evidence",
      "pattern": "CollectionList",
      "states": [
        "empty",
        "loading",
        "partial",
        "error"
      ],
      "stories": [
        "US-002"
      ],
      "actions": [
        {
          "id": "retry",
          "label": "Try again",
          "to": "state:loading"
        }
      ],
      "content": [
        {
          "kind": "text",
          "label": "Account cards/rows: plan, current windows and resets; selected-period usage/value/expense; grouped missing evidence"
        }
      ]
    },
    {
      "id": "system",
      "title": "System",
      "purpose": "Investigate capture, delivery, reporting and host health",
      "pattern": "ReportViewer",
      "states": [
        "empty",
        "loading",
        "partial",
        "error"
      ],
      "stories": [
        "US-001"
      ],
      "actions": [
        {
          "id": "retry",
          "label": "Try again",
          "to": "state:loading"
        }
      ],
      "content": [
        {
          "kind": "text",
          "label": "Capture checkpoints; delivery receipts; reporting backlog and through-time; machine/load correlations"
        }
      ]
    }
